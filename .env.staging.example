# ─── Noetia STAGING environment template (NEM-006A) ──────────────────────────
# Copy to `.env.staging` ON THE STAGING HOST and fill in. NEVER commit `.env.staging`.
# Values here are placeholders/guidance only — no real secrets in Git.
# Staging must NOT reuse production secrets (separate DB, JWT, MinIO, Stripe, etc.).

# ── Runtime identity ─────────────────────────────────────────────────────────
APP_ENV=staging
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=staging          # drives the STAGING banner + noindex in web

# ── URLs (staging hostnames; DNS is a Product Owner action) ─────────────────
WEB_URL=https://staging.noetia.app
API_URL=https://staging.noetia.app
NEXT_PUBLIC_API_URL=https://staging.noetia.app/api
INTERNAL_API_URL=http://api:4000     # SSR → api service inside noetia_staging_net

# ── Traefik basic-auth gate (NOT public) ─────────────────────────────────────
# Generate on the host:  htpasswd -nbB stager '<password>'  (escape $ as $$ for compose)
STAGING_BASICAUTH=stager:$$2y$$...replace-with-bcrypt-hash...

# ── PostgreSQL (staging DB — separate from prod) ────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=noetia_staging
DB_USER=noetia
DB_PASS=changeme-staging-db-pass     # staging-only credential

# ── Redis / cache ────────────────────────────────────────────────────────────
REDIS_URL=redis://cache:6379

# ── JWT / auth (staging-only secrets) ───────────────────────────────────────
JWT_SECRET=changeme-staging-jwt-secret
JWT_EXPIRES_IN=15m

# ── MinIO (staging buckets/credentials) ─────────────────────────────────────
MINIO_ENDPOINT=storage
MINIO_PORT=9000
MINIO_ACCESS_KEY=changeme-staging-minio-key
MINIO_SECRET_KEY=changeme-staging-minio-secret
MINIO_PUBLIC_URL=https://storage.staging.noetia.app

# ── Meilisearch ──────────────────────────────────────────────────────────────
MEILI_HOST=http://search:7700
MEILI_MASTER_KEY=changeme-staging-meili-key

# ── Stripe — TEST MODE ONLY (never live keys on staging) ────────────────────
STRIPE_SECRET_KEY=sk_test_...                 # MUST be a sk_test_ key
STRIPE_WEBHOOK_SECRET=whsec_...test...         # test-mode webhook signing secret
# Staging Stripe products/prices are TEST-mode. No real charges are possible.

# ── Email safety — staging must NOT email real users ────────────────────────
# Default: leave SMTP unconfigured so email is effectively disabled on staging,
# OR use a dedicated sink / restricted recipient. Do NOT reuse the prod Resend key
# in a way that could email real beta users.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Noetia Staging <staging@noetia.app>
EMAIL_SAFE_MODE=true                  # (documented convention; suppress real sends)

# ── OAuth (staging callback URLs — Product Owner console action; see EXTERNAL-ACTIONS) ─
# Leave blank to fall back to email/password login on staging.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Social publishing token encryption (staging-only) ───────────────────────
SOCIAL_TOKEN_SECRET=changeme-staging-social-secret

# ── Sentry (optional on staging; use a separate 'staging' environment tag) ──
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── FUTURE AI providers (PO-005) — location reserved, DO NOT populate in NEM-006A ─
# NEM-006A does not enable AI. These are the configuration slots future missions
# (resumed NEM-006 / NEM-006B) will use. Provider/model configurable under ADR-001.
# Never commit real keys; never enable provider training/data-sharing (ADR-002).
# GEMINI_API_KEY=          # Google — gemini-embedding-001 (768d) + gemini-3.5-flash-lite
# OPENAI_API_KEY=          # OpenAI — GPT-5.6 Luna (fallback) / Terra (advanced)
# ANTHROPIC_API_KEY=       # Anthropic — Claude Sonnet 5 (future challenger)
# AI_EMBEDDING_MODEL=gemini-embedding-001
# AI_EMBEDDING_DIM=768
