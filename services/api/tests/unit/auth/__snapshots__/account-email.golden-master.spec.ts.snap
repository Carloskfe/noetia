exports[`B2-A2a golden master — valid preferences (must stay byte-identical) account-deletion farewell without a name, stored en: farewell/no-name/en 1`] = `
{
  "from": "Noetia <noreply@noetia.app>",
  "html": "
<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>
<body style="margin:0;padding:0;background:#f4f6f9;font-family:'Segoe UI',Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f9;padding:40px 0;">
    <tr><td align="center">
      <table width="560" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);">
        <tr><td style="background:#0D1B2A;padding:32px 40px;text-align:center;">
          <h1 style="margin:0;color:#ffffff;font-size:28px;font-weight:700;letter-spacing:2px;">NOETIA</h1>
        </td></tr>
        <tr><td style="padding:40px;">
          <p style="margin:0 0 16px;color:#1E293B;font-size:18px;font-weight:600;">Until next time, Reader.</p>
          <p style="margin:0 0 24px;color:#475569;font-size:15px;line-height:1.6;">
            Your account has been successfully deleted. All your data — fragments, library, and preferences — has been erased from our systems.
          </p>
          <p style="margin:0 0 24px;color:#475569;font-size:15px;line-height:1.6;">
            If you changed your mind or deleted your account by mistake, you can register again at any time at <a href="https://noetia.test/register" style="color:#0D1B2A;font-weight:600;">noetia.app</a>.
          </p>
          <p style="margin:0;color:#94A3B8;font-size:13px;">
            Thank you for being part of the Noetia community. We hope to see you again.
          </p>
        </td></tr>
        <tr><td style="background:#F8FAFC;padding:20px 40px;text-align:center;border-top:1px solid #E2E8F0;">
          <p style="margin:0;color:#94A3B8;font-size:12px;">© 2026 Noetia. All rights reserved.</p>
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>",
  "subject": "Your Noetia account has been deleted",
  "to": "reader@example.com",
}
`;

