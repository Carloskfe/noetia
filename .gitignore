# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/

# Environment — real secret files must NEVER be staged.
# `/opt/noetia` and `/opt/noetia-staging` are themselves git checkouts that hold
# .env.production / .env.staging, so an unguarded `git add .` on the server would
# stage live credentials. The three patterns below previously matched neither
# file (NEM-009 / IG-DR-02). Committed `*.example` templates stay tracked.
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Expo / React Native
.expo/
services/mobile/google-services.json
services/mobile/GoogleService-Info.plist
services/mobile/google-play-key.json
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
android/
ios/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
*.pyc

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/

# Docker
.docker/

# TypeScript
*.tsbuildinfo

# Large media files — transcription source files are committed but raw
# audio (MP3, M4B, WAV, MP4) must never be checked in (100MB+ each).
transcriptions/**/*.mp3
transcriptions/**/*.m4b
transcriptions/**/*.wav
transcriptions/**/*.mp4
transcriptions/**/*.ogg
transcriptions/**/*.flac
